{
  "name": "@intgetion/taxonomy",
  "version": "0.3.0",
  "description": "Skill taxonomy for INTGETION JOB LIST: skill catalog, aliases, normalization, suggestions, job categories.",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": "./src/modules/taxonomy/service/index.ts",
    "./catalog": "./src/catalog/index.ts",
    "./server": "./src/server/app.ts"
  },
  "scripts": {
    "dev": "tsx watch src/server/main.ts",
    "start": "tsx src/server/main.ts",
    "migrate": "tsx scripts/migrate.ts",
    "render-migration": "tsx scripts/render-migration.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@intgetion/kit": "github:theonyxiesss/intgetion-kit#v0.2.0",
    "drizzle-orm": "^0.45.3",
